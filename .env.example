# All keys are optional. Local mode needs none.
# Copy to .env in the project directory; never commit real keys.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional AI prompt optimizer. Get a key at https://console.groq.com/keys
# Only clicking Optimize with Groq generates a rewrite and uses API tokens.
GROQ_API_KEY=
TOKEN_SAVER_DB=data/token_saver.sqlite3
TOKEN_SAVER_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional writable location for tokenizer vocabularies:
# TIKTOKEN_CACHE_DIR=data/tokenizer-cache
